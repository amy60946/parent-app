// moyo-site: moyoapp.com.tr kökü (tanıtım, /img/*, /d/*, /.well-known/apple-app-site-association). Yalnız statik dosya.
// workers_dev ve preview_urls KAPALI: açık kalırsa *.workers.dev adresi önizleme kilidi olmadan herkese açılır.
// routes YOK: route'ları yönetim paneli penceresi bağlar (kökte panelin /destek ve /yasal route'larıyla çakışmasın diye).
// Derleme: bash site/build-cf.sh site · Yayın: npx wrangler@4 deploy -c wrangler.site.jsonc
{
  "name": "moyo-site",
  "compatibility_date": "2025-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./dist-site", "html_handling": "auto-trailing-slash" }
}
